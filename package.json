{
  "name": "vaultos",
  "version": "0.1.0-preview.1",
  "description": "A local-first macOS vault that lets coding agents use project secrets without returning them in tool responses.",
  "main": "main.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit3a/vaultos.git"
  },
  "bugs": {
    "url": "https://github.com/rohit3a/vaultos/issues"
  },
  "homepage": "https://github.com/rohit3a/vaultos#readme",
  "scripts": {
    "start": "electron .",
    "backend": "node backend.cjs",
    "test": "node --test test/*.test.js",
    "test:ui": "node scripts/test-ui.mjs",
    "check": "node scripts/check.mjs && npm test",
    "build:native": "node scripts/build-native.mjs",
    "dist:mac": "node scripts/package-mac.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "@electron/packager": "20.3.0",
    "@electron/osx-sign": "2.7.0",
    "@electron/notarize": "3.1.1",
    "@electron/fuses": "2.1.3",
    "playwright": "1.63.0",
    "terser": "5.51.2"
  }
}
